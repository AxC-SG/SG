# Copy to backend/.env.local (properties format) for disposable local development.
# Hosting/runtime and privileged migrator settings must be supplied separately;
# this example is not a deployed-service configuration or migration authorization.
APP_ENVIRONMENT=local
APP_RUNTIME_ROLE=all
APP_JWT_AUTH_MODE=LOCAL
APP_JWT_LOCAL_ISSUER=urn:scoutgrid:local
APP_SECURITY_JWT_AUDIENCE=scoutgrid-api
OPENAI_ENABLED=false
# EXTERNAL mode instead requires APP_JWT_ISSUER_URI and no local HMAC secret.
# API-key/header tenant selection are explicit local compatibility only.
# Production builds must not contain VITE static authentication inputs.
# Generate secrets locally; never commit generated values. Keep
# APP_CREDENTIAL_ENCRYPTION_KEY unchanged for the life of any encrypted connector
# credential; retain needed old key versions during explicit rotation.
# Supply matching encryption key material to an authorized one-off migrator.
APP_JWT_HMAC_SECRET=
APP_CREDENTIAL_ENCRYPTION_KEY=

# Local-only platform-owner credential bootstrap. Keep generated values in .env.local.
APP_PLATFORM_OWNER_BOOTSTRAP_ENABLED=false
APP_LOCAL_PLATFORM_OWNER_PASSWORD=
APP_SECURITY_BOOTSTRAP_PLATFORM_OWNERS_USERS_0_EMAIL=
APP_SECURITY_BOOTSTRAP_PLATFORM_OWNERS_USERS_0_DISPLAY_NAME=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_DOMAIN=scoutgrid.io
APP_DEMO_APP_BASE_URL=http://127.0.0.1:5173
APP_DEMO_SYNCHRONOUS_TENANT_PROVISIONING_ENABLED=false

# One-off production migrator only. Never configure these on the permanent web service.
# Inspect deployed history and rehearse on an authorized representative clone first.
# Defaults below do not authorize bootstrap, live email, reset or rotation.
PLATFORM_OWNER_SETUP_LINK_ENABLED=false
PLATFORM_OWNER_SETUP_EMAIL=
PLATFORM_OWNER_SETUP_APP_BASE_URL=https://scoutgrid.io
PLATFORM_OWNER_SETUP_TOKEN_TTL_MINUTES=30
PLATFORM_OWNER_SETUP_ALLOW_REISSUE=false
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Optional local-only shared login. Disabled unless explicitly enabled.
APP_SHARED_LOCALHOST_LOGIN_ENABLED=false
APP_SHARED_LOCALHOST_TENANT_ADMIN_EMAIL=
APP_SHARED_LOCALHOST_TENANT_ADMIN_PASSWORD_HASH=
