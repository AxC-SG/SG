{
  "description": "Maintained CBOM secret-detector GA corpus. High-entropy values are @@TOKEN@@ placeholders that the test generates at run time, so the repository never contains secret-shaped literals. 'forbidden' entries must be detected with the expected code; 'valid' entries are legitimate public/cryptographic material and must produce no detection at all.",
  "forbidden": [
    {"id": "pem-pkcs8-private-key-in-description", "expect": "PRIVATE_KEY_PEM", "structural": true,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "signing-key", "description": "@@PKCS8_PRIVATE_PEM@@"}]}},
    {"id": "pem-rsa-private-key-in-property", "expect": "PRIVATE_KEY_PEM", "structural": true,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "legacy-key", "properties": [{"name": "debug", "value": "@@RSA_PRIVATE_PEM@@"}]}]}},
    {"id": "pem-encrypted-private-key", "expect": "PRIVATE_KEY_PEM", "structural": true,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "metadata": {"properties": [{"name": "backup", "value": "@@ENCRYPTED_PRIVATE_PEM@@"}]}, "components": []}},
    {"id": "pgp-private-key-block", "expect": "PGP_PRIVATE_KEY_BLOCK", "structural": true,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "release-signing", "description": "@@PGP_PRIVATE_BLOCK@@"}]}},
    {"id": "cdx-private-key-material-value", "expect": "CDX_SECRET_MATERIAL_VALUE", "structural": true,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "api-tls-key", "cryptoProperties": {"assetType": "related-crypto-material", "relatedCryptoMaterialProperties": {"type": "private-key", "value": "@@BASE64_64@@", "size": 2048}}}]}},
    {"id": "cdx-password-material-with-spaces", "expect": "CDX_SECRET_MATERIAL_VALUE", "structural": true,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "db-pass", "cryptoProperties": {"assetType": "related-crypto-material", "relatedCryptoMaterialProperties": {"type": "password", "value": "@@PASSPHRASE@@"}}}]}},
    {"id": "aws-access-key-id", "expect": "AWS_ACCESS_KEY_ID", "structural": true,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "s3-client", "properties": [{"name": "aws.credential", "value": "@@AWS_KEY_ID@@"}]}]}},
    {"id": "github-token", "expect": "GITHUB_TOKEN", "structural": true,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "ci", "description": "token @@GITHUB_TOKEN@@"}]}},
    {"id": "slack-token", "expect": "SLACK_TOKEN", "structural": true,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "notifier", "properties": [{"name": "hook", "value": "@@SLACK_TOKEN@@"}]}]}},
    {"id": "google-api-key", "expect": "GOOGLE_API_KEY", "structural": true,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "maps", "description": "@@GOOGLE_KEY@@"}]}},
    {"id": "stripe-live-secret", "expect": "STRIPE_SECRET_KEY", "structural": true,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "billing", "properties": [{"name": "stripe", "value": "@@STRIPE_KEY@@"}]}]}},
    {"id": "client-secret-literal-field", "expect": "SECRET_FIELD_LITERAL", "structural": false,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "oauth", "client_secret": "@@BASE64_32@@"}]}},
    {"id": "password-literal-field", "expect": "SECRET_FIELD_LITERAL", "structural": false,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "keystore", "password": "@@HEX_24@@"}]}},
    {"id": "password-literal-property", "expect": "SECRET_FIELD_LITERAL", "structural": false,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "jks", "properties": [{"name": "keystore.password", "value": "@@HEX_24@@"}]}]}},
    {"id": "api-key-literal-nested", "expect": "SECRET_FIELD_LITERAL", "structural": false,
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "metadata": {"tools": [{"name": "scanner", "config": {"apiKey": "@@BASE64_32@@"}}]}, "components": []}}
  ],
  "valid": [
    {"id": "public-certificate-pem",
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "api.example.com", "cryptoProperties": {"assetType": "certificate", "certificateProperties": {"subjectName": "CN=api.example.com", "issuerName": "CN=Example CA", "notValidAfter": "2027-01-01T00:00:00Z", "signatureAlgorithmRef": "crypto/alg/sha256-rsa", "certificateFormat": "X.509"}}, "properties": [{"name": "pem", "value": "@@CERT_PEM@@"}]}]}},
    {"id": "public-key-material-value",
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "jwks-key", "cryptoProperties": {"assetType": "related-crypto-material", "relatedCryptoMaterialProperties": {"type": "public-key", "value": "@@RSA_PUBLIC_PEM@@", "size": 2048}}}]}},
    {"id": "private-key-declared-without-value",
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "tls-key", "cryptoProperties": {"assetType": "related-crypto-material", "relatedCryptoMaterialProperties": {"type": "private-key", "id": "key-2026-01", "state": "active", "size": 3072, "securedBy": {"mechanism": "HSM", "algorithmRef": "crypto/alg/aes-256-gcm"}}}}]}},
    {"id": "private-key-referenced-in-vault",
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "signing", "cryptoProperties": {"assetType": "related-crypto-material", "relatedCryptoMaterialProperties": {"type": "private-key", "value": "vault:secret/data/signing#key"}}}]}},
    {"id": "secret-fields-holding-references",
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "svc", "password": "${DB_PASSWORD}", "client_secret": "arn:aws:secretsmanager:us-east-1:123456789012:secret:svc", "apiKey": "REDACTED", "privateKey": "kms://projects/p/locations/l/keyRings/r/cryptoKeys/k"}]}},
    {"id": "descriptions-that-discuss-secrets",
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "custody", "description": "Private keys are generated inside the HSM and never exported; passwords rotate every 90 days."}]}},
    {"id": "fingerprints-and-identifiers",
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "bom-ref": "crypto/cert/@@HEX_24@@", "name": "edge", "properties": [{"name": "sha256Fingerprint", "value": "@@SHA256_HEX@@"}, {"name": "keyId", "value": "@@HEX_24@@"}, {"name": "serialNumber", "value": "@@HEX_24@@"}, {"name": "oid", "value": "1.2.840.113549.1.1.11"}]}]}},
    {"id": "algorithm-inventory",
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "AES-256-GCM", "cryptoProperties": {"assetType": "algorithm", "algorithmProperties": {"primitive": "ae", "parameterSetIdentifier": "256", "mode": "gcm", "cryptoFunctions": ["encrypt", "decrypt"]}, "oid": "2.16.840.1.101.3.4.1.46"}}, {"type": "cryptographic-asset", "name": "ML-KEM-768", "cryptoProperties": {"assetType": "algorithm", "algorithmProperties": {"primitive": "kem", "parameterSetIdentifier": "768"}}}]}},
    {"id": "protocol-with-cipher-suites",
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "TLS", "cryptoProperties": {"assetType": "protocol", "protocolProperties": {"type": "tls", "version": "1.3", "cipherSuites": [{"name": "TLS_AES_256_GCM_SHA384", "identifiers": ["0x13", "0x02"]}]}}}]}},
    {"id": "secret-named-token-type-material-without-value",
     "document": {"bomFormat": "CycloneDX", "specVersion": "1.6", "components": [{"type": "cryptographic-asset", "name": "session-token", "cryptoProperties": {"assetType": "related-crypto-material", "relatedCryptoMaterialProperties": {"type": "token", "format": "JWT", "expirationDate": "2026-12-01T00:00:00Z"}}}]}}
  ]
}
