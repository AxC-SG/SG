{
 "Version": "2012-10-17",
 "Statement": [
  {
   "Sid": "RegisterReviewedApiTaskDefinition",
   "Effect": "Allow",
   "Action": [
    "ecs:RegisterTaskDefinition"
   ],
   "Resource": "arn:aws:ecs:ap-southeast-2:736486260824:task-definition/scoutgrid-lab-api:*",
   "Condition": {
    "StringEquals": {
     "aws:RequestedRegion": "ap-southeast-2",
     "aws:RequestTag/Application": "ScoutGrid",
     "aws:RequestTag/Environment": "lab",
     "aws:RequestTag/Profile": "Standard",
     "aws:RequestTag/ManagedBy": "Terraform"
    },
    "StringEqualsIfExists": {
     "ecs:privileged": "false"
    },
    "NumericEquals": {
     "ecs:task-cpu": 512,
     "ecs:task-memory": 2048
    },
    "ForAllValues:StringEquals": {
     "ecs:compute-compatibility": "FARGATE"
    },
    "Null": {
     "ecs:compute-compatibility": "false"
    }
   }
  },
  {
   "Sid": "RegisterReviewedWorkerTaskDefinition",
   "Effect": "Allow",
   "Action": [
    "ecs:RegisterTaskDefinition"
   ],
   "Resource": "arn:aws:ecs:ap-southeast-2:736486260824:task-definition/scoutgrid-lab-worker:*",
   "Condition": {
    "StringEquals": {
     "aws:RequestedRegion": "ap-southeast-2",
     "aws:RequestTag/Application": "ScoutGrid",
     "aws:RequestTag/Environment": "lab",
     "aws:RequestTag/Profile": "Standard",
     "aws:RequestTag/ManagedBy": "Terraform"
    },
    "StringEqualsIfExists": {
     "ecs:privileged": "false"
    },
    "NumericEquals": {
     "ecs:task-cpu": 1024,
     "ecs:task-memory": 4096
    },
    "ForAllValues:StringEquals": {
     "ecs:compute-compatibility": "FARGATE"
    },
    "Null": {
     "ecs:compute-compatibility": "false"
    }
   }
  },
  {
   "Sid": "RegisterReviewedMigratorTaskDefinition",
   "Effect": "Allow",
   "Action": [
    "ecs:RegisterTaskDefinition"
   ],
   "Resource": "arn:aws:ecs:ap-southeast-2:736486260824:task-definition/scoutgrid-lab-migrator:*",
   "Condition": {
    "StringEquals": {
     "aws:RequestedRegion": "ap-southeast-2",
     "aws:RequestTag/Application": "ScoutGrid",
     "aws:RequestTag/Environment": "lab",
     "aws:RequestTag/Profile": "Standard",
     "aws:RequestTag/ManagedBy": "Terraform"
    },
    "StringEqualsIfExists": {
     "ecs:privileged": "false"
    },
    "NumericEquals": {
     "ecs:task-cpu": 1024,
     "ecs:task-memory": 4096
    },
    "ForAllValues:StringEquals": {
     "ecs:compute-compatibility": "FARGATE"
    },
    "Null": {
     "ecs:compute-compatibility": "false"
    }
   }
  },
  {
   "Sid": "TagNewReviewedTaskDefinitions",
   "Effect": "Allow",
   "Action": [
    "ecs:TagResource"
   ],
   "Resource": [
    "arn:aws:ecs:ap-southeast-2:736486260824:task-definition/scoutgrid-lab-api:*",
    "arn:aws:ecs:ap-southeast-2:736486260824:task-definition/scoutgrid-lab-worker:*",
    "arn:aws:ecs:ap-southeast-2:736486260824:task-definition/scoutgrid-lab-migrator:*"
   ],
   "Condition": {
    "StringEquals": {
     "aws:RequestedRegion": "ap-southeast-2",
     "aws:RequestTag/Application": "ScoutGrid",
     "aws:RequestTag/Environment": "lab",
     "aws:RequestTag/Profile": "Standard",
     "aws:RequestTag/ManagedBy": "Terraform"
    }
   }
  },
  {
   "Sid": "RetireReplacedLabTaskDefinitions",
   "Effect": "Allow",
   "Action": [
    "ecs:DeregisterTaskDefinition"
   ],
   "Resource": "*",
   "Condition": {
    "StringEquals": {
     "aws:RequestedRegion": "ap-southeast-2"
    }
   }
  },
  {
   "Sid": "PassOnlyLabRuntimeRolesToEcsTasks",
   "Effect": "Allow",
   "Action": [
    "iam:PassRole"
   ],
   "Resource": [
    "arn:aws:iam::736486260824:role/scoutgrid-lab-api-execution",
    "arn:aws:iam::736486260824:role/scoutgrid-lab-api-task",
    "arn:aws:iam::736486260824:role/scoutgrid-lab-worker-execution",
    "arn:aws:iam::736486260824:role/scoutgrid-lab-worker-task",
    "arn:aws:iam::736486260824:role/scoutgrid-lab-migrator-execution"
   ],
   "Condition": {
    "StringEquals": {
     "iam:PassedToService": "ecs-tasks.amazonaws.com"
    }
   }
  },
  {
   "Sid": "UpdateLabServicesOnReviewedFamilies",
   "Effect": "Allow",
   "Action": [
    "ecs:UpdateService"
   ],
   "Resource": [
    "arn:aws:ecs:ap-southeast-2:736486260824:service/scoutgrid-lab/api",
    "arn:aws:ecs:ap-southeast-2:736486260824:service/scoutgrid-lab/worker"
   ],
   "Condition": {
    "ArnEquals": {
     "ecs:cluster": "arn:aws:ecs:ap-southeast-2:736486260824:cluster/scoutgrid-lab"
    },
    "ArnLikeIfExists": {
     "ecs:task-definition": [
      "arn:aws:ecs:ap-southeast-2:736486260824:task-definition/scoutgrid-lab-api:*",
      "arn:aws:ecs:ap-southeast-2:736486260824:task-definition/scoutgrid-lab-worker:*"
     ]
    },
    "StringEquals": {
     "aws:RequestedRegion": "ap-southeast-2"
    }
   }
  },
  {
   "Action": [
    "ecs:RunTask"
   ],
   "Condition": {
    "ArnEquals": {
     "ecs:cluster": "arn:aws:ecs:ap-southeast-2:736486260824:cluster/scoutgrid-lab"
    },
    "StringEquals": {
     "aws:RequestTag/Application": "ScoutGrid",
     "aws:RequestTag/Environment": "lab",
     "aws:RequestTag/ReleasePurpose": "Migration",
     "aws:RequestedRegion": "ap-southeast-2"
    },
    "StringEqualsIfExists": {
     "ecs:enable-ebs-volumes": "false",
     "ecs:enable-execute-command": "false"
    }
   },
   "Effect": "Allow",
   "Resource": "arn:aws:ecs:ap-southeast-2:736486260824:task-definition/scoutgrid-lab-migrator:*",
   "Sid": "RunOnlyReviewedMigratorFamily"
  },
  {
   "Action": [
    "ecs:TagResource"
   ],
   "Condition": {
    "ForAllValues:StringEquals": {
     "aws:TagKeys": [
      "Application",
      "Environment",
      "ReleasePurpose"
     ]
    },
    "Null": {
     "aws:TagKeys": "false"
    },
    "StringEquals": {
     "aws:RequestTag/Application": "ScoutGrid",
     "aws:RequestTag/Environment": "lab",
     "aws:RequestTag/ReleasePurpose": "Migration",
     "aws:RequestedRegion": "ap-southeast-2",
     "ecs:CreateAction": "RunTask"
    }
   },
   "Effect": "Allow",
   "Resource": "arn:aws:ecs:ap-southeast-2:736486260824:task/scoutgrid-lab/*",
   "Sid": "TagOnlyTasksAtApprovedLaunch"
  },
  {
   "Sid": "StopOnlyLabTasks",
   "Effect": "Allow",
   "Action": [
    "ecs:StopTask"
   ],
   "Resource": "arn:aws:ecs:ap-southeast-2:736486260824:task/scoutgrid-lab/*",
   "Condition": {
    "StringEquals": {
     "aws:RequestedRegion": "ap-southeast-2"
    }
   }
  },
  {
   "Sid": "SnapshotLabDatabaseBeforeMigration",
   "Effect": "Allow",
   "Action": [
    "rds:CreateDBSnapshot",
    "rds:AddTagsToResource"
   ],
   "Resource": [
    "arn:aws:rds:ap-southeast-2:736486260824:db:scoutgrid-lab",
    "arn:aws:rds:ap-southeast-2:736486260824:snapshot:scoutgrid-lab-release-*"
   ],
   "Condition": {
    "StringEquals": {
     "aws:RequestedRegion": "ap-southeast-2"
    }
   }
  },
  {
   "Sid": "ReadLabReleaseSnapshots",
   "Effect": "Allow",
   "Action": [
    "rds:DescribeDBSnapshots"
   ],
   "Resource": [
    "arn:aws:rds:ap-southeast-2:736486260824:db:scoutgrid-lab",
    "arn:aws:rds:ap-southeast-2:736486260824:snapshot:scoutgrid-lab-release-*"
   ],
   "Condition": {
    "StringEquals": {
     "aws:RequestedRegion": "ap-southeast-2"
    }
   }
  },
  {
   "Sid": "ReadApiTargetHealth",
   "Effect": "Allow",
   "Action": [
    "elasticloadbalancing:DescribeTargetGroups",
    "elasticloadbalancing:DescribeTargetHealth"
   ],
   "Resource": "*",
   "Condition": {
    "StringEquals": {
     "aws:RequestedRegion": "ap-southeast-2"
    }
   }
  },
  {
   "Sid": "ReadLabTaskLogs",
   "Effect": "Allow",
   "Action": [
    "logs:FilterLogEvents",
    "logs:GetLogEvents"
   ],
   "Resource": [
    "arn:aws:logs:ap-southeast-2:736486260824:log-group:/ecs/scoutgrid-lab/*"
   ]
  },
  {
   "Sid": "ManageReleaseInputsAndRecords",
   "Effect": "Allow",
   "Action": [
    "s3:GetObject",
    "s3:PutObject"
   ],
   "Resource": [
    "arn:aws:s3:::scoutgrid-lab-tfstate-736486260824-ap-southeast-2/standard/lab/release/inputs.json",
    "arn:aws:s3:::scoutgrid-lab-tfstate-736486260824-ap-southeast-2/standard/lab/release/records/*"
   ]
  },
  {
   "Sid": "ManageReleaseLock",
   "Effect": "Allow",
   "Action": [
    "s3:GetObject",
    "s3:PutObject",
    "s3:DeleteObject"
   ],
   "Resource": [
    "arn:aws:s3:::scoutgrid-lab-tfstate-736486260824-ap-southeast-2/standard/lab/release/lock.json"
   ]
  },
  {
   "Sid": "ReadOnlyNamedLabBucketWebsiteMetadata",
   "Effect": "Allow",
   "Action": [
    "s3:GetBucketWebsite"
   ],
   "Resource": [
    "arn:aws:s3:::scoutgrid-lab-736486260824-imports",
    "arn:aws:s3:::scoutgrid-lab-736486260824-exports"
   ],
   "Condition": {
    "StringEquals": {
     "s3:ResourceAccount": "736486260824"
    }
   }
  }
 ]
}
