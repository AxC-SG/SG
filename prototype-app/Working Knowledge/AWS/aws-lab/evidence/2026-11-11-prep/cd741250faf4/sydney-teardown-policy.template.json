      "Resource": "arn:aws:cognito-idp:ap-southeast-2:736486260824:userpool/BOOTSTRAP_COGNITO_POOL_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadCognitoDomainByName",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPoolDomain"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadLabAmplifyApp",
      "Effect": "Allow",
      "Action": [
        "amplify:GetApp",
        "amplify:ListTagsForResource"
      ],
      "Resource": "arn:aws:amplify:ap-southeast-2:736486260824:apps/BOOTSTRAP_AMPLIFY_APP_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadLabAmplifyBranch",
      "Effect": "Allow",
      "Action": [
        "amplify:GetBranch",
        "amplify:ListTagsForResource"
      ],
      "Resource": "arn:aws:amplify:ap-southeast-2:736486260824:apps/BOOTSTRAP_AMPLIFY_APP_ID/branches/lab",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
