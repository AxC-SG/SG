        "arn:aws:ec2:ap-southeast-2:736486260824:route-table/CREATED_ROUTE_TABLE_3_ID",
        "arn:aws:ec2:ap-southeast-2:736486260824:route-table/CREATED_ROUTE_TABLE_4_ID",
        "arn:aws:ec2:ap-southeast-2:736486260824:route-table/CREATED_ROUTE_TABLE_5_ID",
        "arn:aws:ec2:ap-southeast-2:736486260824:route-table/CREATED_ROUTE_TABLE_6_ID"
