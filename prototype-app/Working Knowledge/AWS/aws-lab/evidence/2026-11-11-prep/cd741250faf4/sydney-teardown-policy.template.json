      ],
      "Resource": "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:CREATED_RDS_SECRET_NAME",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "RetireLabKeys",
      "Effect": "Allow",
      "Action": [
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": [
        "arn:aws:kms:ap-southeast-2:736486260824:key/BOOTSTRAP_DB_KEY_ID",
        "arn:aws:kms:ap-southeast-2:736486260824:key/BOOTSTRAP_OBJECT_KEY_ID"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
