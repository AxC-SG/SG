    {
      "Sid": "RemoveLabImportsCors",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketCORS"
      ],
      "Resource": "arn:aws:s3:::scoutgrid-lab-736486260824-imports",
      "Condition": {
        "StringEquals": {
