      "Effect": "Allow",
      "Action": [
        "ec2:DeleteNatGateway"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:natgateway/CREATED_NAT_1_ID",
        "arn:aws:ec2:ap-southeast-2:736486260824:natgateway/CREATED_NAT_2_ID"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
