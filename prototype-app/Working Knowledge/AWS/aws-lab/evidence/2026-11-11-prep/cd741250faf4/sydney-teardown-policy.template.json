        "arn:aws:ec2:ap-southeast-2:736486260824:subnet/CREATED_SUBNET_3_ID",
        "arn:aws:ec2:ap-southeast-2:736486260824:subnet/CREATED_SUBNET_4_ID",
        "arn:aws:ec2:ap-southeast-2:736486260824:subnet/CREATED_SUBNET_5_ID",
        "arn:aws:ec2:ap-southeast-2:736486260824:subnet/CREATED_SUBNET_6_ID"
