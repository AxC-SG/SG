      "Effect": "Allow",
      "Action": [
        "rds:ModifyDBInstance",
        "rds:DeleteDBInstance"
      ],
      "Resource": "arn:aws:rds:ap-southeast-2:736486260824:db:scoutgrid-lab",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "RemoveLabParameterGroup",
      "Effect": "Allow",
      "Action": [
        "rds:DeleteDBParameterGroup"
      ],
      "Resource": "arn:aws:rds:ap-southeast-2:736486260824:pg:scoutgrid-lab-postgres16",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
