      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:vpc-endpoint/CREATED_S3_ENDPOINT_ID"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
