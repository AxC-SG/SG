{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LocateLabStateBucket",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::scoutgrid-lab-tfstate-736486260824-ap-southeast-2"
    },
    {
      "Sid": "ListLabStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::scoutgrid-lab-tfstate-736486260824-ap-southeast-2"
    },
    {
      "Sid": "ReadWriteExactState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::scoutgrid-lab-tfstate-736486260824-ap-southeast-2/standard/lab/terraform.tfstate"
    },
    {
      "Sid": "ManageLabStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::scoutgrid-lab-tfstate-736486260824-ap-southeast-2/standard/lab/terraform.tfstate.tflock"
    },
    {
      "Sid": "UseSydneyStateKeyThroughS3",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:ap-southeast-2:736486260824:key/2731031f-d79e-4db9-afe6-94fb01cba15a",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.ap-southeast-2.amazonaws.com",
          "kms:CallerAccount": "736486260824",
          "kms:EncryptionContext:aws:s3:arn": "arn:aws:s3:::scoutgrid-lab-tfstate-736486260824-ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadSydneyNetworking",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAddresses",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeManagedPrefixLists",
        "ec2:DescribeNatGateways",
        "ec2:DescribeNetworkAcls",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribePrefixLists",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeVpcEndpointServices",
        "ec2:DescribeVpcs",
        "ec2:DescribeAddressesAttribute"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadSydneyDatabaseInstances",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances"
      ],
      "Resource": "arn:aws:rds:ap-southeast-2:736486260824:db:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadLabParameterGroup",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBParameterGroups",
        "rds:DescribeDBParameters"
      ],
      "Resource": "arn:aws:rds:ap-southeast-2:736486260824:pg:scoutgrid-lab-postgres16",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadLabSubnetGroup",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBSubnetGroups"
      ],
      "Resource": "arn:aws:rds:ap-southeast-2:736486260824:subgrp:scoutgrid-lab",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadLabDatabaseTags",
      "Effect": "Allow",
      "Action": [
        "rds:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:rds:ap-southeast-2:736486260824:db:scoutgrid-lab",
        "arn:aws:rds:ap-southeast-2:736486260824:pg:scoutgrid-lab-postgres16",
        "arn:aws:rds:ap-southeast-2:736486260824:subgrp:scoutgrid-lab"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadBootstrapKeys",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags"
      ],
      "Resource": [
        "arn:aws:kms:ap-southeast-2:736486260824:key/BOOTSTRAP_DB_KEY_ID",
        "arn:aws:kms:ap-southeast-2:736486260824:key/BOOTSTRAP_OBJECT_KEY_ID"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
