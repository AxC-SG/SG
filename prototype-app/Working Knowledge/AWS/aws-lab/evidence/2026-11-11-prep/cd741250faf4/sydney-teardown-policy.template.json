      "Sid": "RemoveLabSubnetGroup",
      "Effect": "Allow",
      "Action": [
        "rds:DeleteDBSubnetGroup"
      ],
      "Resource": "arn:aws:rds:ap-southeast-2:736486260824:subgrp:scoutgrid-lab",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadLabManagedSecretMetadata",
      "Effect": "Allow",
      "Action": [
