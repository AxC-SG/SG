      "Sid": "CreateTaggedLabEcrRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:TagResource"
      ],
      "Resource": "arn:aws:ecr:ap-southeast-2:736486260824:repository/scoutgrid-lab-backend",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "UpdateLabAmplifyApp",
      "Effect": "Allow",
      "Action": [
        "amplify:UpdateApp"
      ],
      "Resource": "arn:aws:amplify:ap-southeast-2:736486260824:apps/BOOTSTRAP_AMPLIFY_APP_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    }
  ]
}
