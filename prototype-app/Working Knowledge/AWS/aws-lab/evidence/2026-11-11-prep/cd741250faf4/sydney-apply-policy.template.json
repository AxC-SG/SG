          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "ScoutGrid",
          "aws:ResourceTag/Environment": "lab",
          "aws:ResourceTag/Profile": "Standard",
          "aws:ResourceTag/ManagedBy": "Terraform"
