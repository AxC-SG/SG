      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ReadLabAmplifyApp",
      "Effect": "Allow",
      "Action": [
        "amplify:GetApp",
        "amplify:ListTagsForResource"
      ],
      "Resource": "arn:aws:amplify:ap-southeast-2:736486260824:apps/BOOTSTRAP_AMPLIFY_APP_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
