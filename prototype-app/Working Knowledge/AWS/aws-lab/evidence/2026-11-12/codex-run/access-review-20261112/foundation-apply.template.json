{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTaggedNetworkRoots",
      "Effect": "Allow",
      "Action": [
        "ec2:AllocateAddress",
        "ec2:CreateInternetGateway",
        "ec2:CreateVpc"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:elastic-ip/*",
        "arn:aws:ec2:ap-southeast-2:736486260824:internet-gateway/*",
        "arn:aws:ec2:ap-southeast-2:736486260824:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "CreateTaggedVpcChildren",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateSubnet"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:route-table/*",
        "arn:aws:ec2:ap-southeast-2:736486260824:security-group/*",
        "arn:aws:ec2:ap-southeast-2:736486260824:subnet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "CreateTaggedSingleNat",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNatGateway"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:natgateway/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "CreateTaggedS3Endpoint",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:vpc-endpoint/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform",
          "ec2:VpceServiceName": "com.amazonaws.ap-southeast-2.s3"
        }
      }
    },
    {
      "Sid": "TagOnlyNewNetworkResources",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:elastic-ip/*",
        "arn:aws:ec2:ap-southeast-2:736486260824:internet-gateway/*",
        "arn:aws:ec2:ap-southeast-2:736486260824:vpc/*",
        "arn:aws:ec2:ap-southeast-2:736486260824:route-table/*",
        "arn:aws:ec2:ap-southeast-2:736486260824:security-group/*",
        "arn:aws:ec2:ap-southeast-2:736486260824:subnet/*",
        "arn:aws:ec2:ap-southeast-2:736486260824:natgateway/*",
        "arn:aws:ec2:ap-southeast-2:736486260824:vpc-endpoint/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform",
          "ec2:CreateAction": [
            "AllocateAddress",
            "CreateInternetGateway",
            "CreateVpc",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "CreateSubnet",
            "CreateNatGateway",
            "CreateVpcEndpoint"
          ]
        }
      }
    },
    {
      "Sid": "UseOnlyTaggedLabVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateNatGateway",
        "ec2:CreateVpcEndpoint",
        "ec2:AttachInternetGateway",
        "ec2:ModifyVpcAttribute"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "ScoutGrid",
          "aws:ResourceTag/Environment": "lab",
          "aws:ResourceTag/Profile": "Standard",
          "aws:ResourceTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "UseOnlyTaggedNatInputs",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNatGateway"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:subnet/*",
        "arn:aws:ec2:ap-southeast-2:736486260824:elastic-ip/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "ScoutGrid",
          "aws:ResourceTag/Environment": "lab",
          "aws:ResourceTag/Profile": "Standard",
          "aws:ResourceTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "UseOnlyTaggedEndpointRoutes",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "ScoutGrid",
          "aws:ResourceTag/Environment": "lab",
          "aws:ResourceTag/Profile": "Standard",
          "aws:ResourceTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "AttachOnlyTaggedGateway",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachInternetGateway"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:internet-gateway/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "ScoutGrid",
          "aws:ResourceTag/Environment": "lab",
          "aws:ResourceTag/Profile": "Standard",
          "aws:ResourceTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "ConfigureOnlyTaggedRoutes",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateRouteTable",
        "ec2:CreateRoute"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "ScoutGrid",
          "aws:ResourceTag/Environment": "lab",
          "aws:ResourceTag/Profile": "Standard",
          "aws:ResourceTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "ConfigureOnlyTaggedSubnets",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateRouteTable",
        "ec2:ModifySubnetAttribute"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:subnet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "ScoutGrid",
          "aws:ResourceTag/Environment": "lab",
          "aws:ResourceTag/Profile": "Standard",
          "aws:ResourceTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "RemoveDefaultDbEgress",
      "Effect": "Allow",
      "Action": [
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:736486260824:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "ScoutGrid",
          "aws:ResourceTag/Environment": "lab",
          "aws:ResourceTag/Profile": "Standard",
          "aws:ResourceTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "CreateNamedDatabaseGroups",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBParameterGroup",
        "rds:CreateDBSubnetGroup"
      ],
      "Resource": [
        "arn:aws:rds:ap-southeast-2:736486260824:pg:scoutgrid-lab-postgres16",
        "arn:aws:rds:ap-southeast-2:736486260824:subgrp:scoutgrid-lab"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "ConfigureNamedDatabaseParameters",
      "Effect": "Allow",
      "Action": [
        "rds:ModifyDBParameterGroup"
      ],
      "Resource": "arn:aws:rds:ap-southeast-2:736486260824:pg:scoutgrid-lab-postgres16",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "CreateOnlyPrivateEncryptedManagedPasswordDb",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": [
        "arn:aws:rds:ap-southeast-2:736486260824:db:scoutgrid-lab",
        "arn:aws:rds:ap-southeast-2:736486260824:pg:scoutgrid-lab-postgres16",
        "arn:aws:rds:ap-southeast-2:736486260824:subgrp:scoutgrid-lab"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        },
        "Bool": {
          "rds:PubliclyAccessible": "false",
          "rds:ManageMasterUserPassword": "true"
        }
      }
    },
    {
      "Sid": "TagNamedDatabaseResources",
      "Effect": "Allow",
      "Action": [
        "rds:AddTagsToResource"
      ],
      "Resource": [
        "arn:aws:rds:ap-southeast-2:736486260824:db:scoutgrid-lab",
        "arn:aws:rds:ap-southeast-2:736486260824:pg:scoutgrid-lab-postgres16",
        "arn:aws:rds:ap-southeast-2:736486260824:subgrp:scoutgrid-lab"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "UseFreshDatabaseKeyThroughAwsServices",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:ap-southeast-2:736486260824:key/RENDER_FRESH_DATABASE_KEY",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "kms:CallerAccount": "736486260824",
          "kms:ViaService": [
            "rds.ap-southeast-2.amazonaws.com",
            "secretsmanager.ap-southeast-2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "GrantFreshDatabaseKeyToAwsResources",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant"
      ],
      "Resource": "arn:aws:kms:ap-southeast-2:736486260824:key/RENDER_FRESH_DATABASE_KEY",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "kms:CallerAccount": "736486260824",
          "kms:ViaService": [
            "rds.ap-southeast-2.amazonaws.com",
            "secretsmanager.ap-southeast-2.amazonaws.com"
          ]
        },
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    },
    {
      "Sid": "OnlyRdsForwardedManagedSecretSetup",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:TagResource"
      ],
      "Resource": "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:rds!db-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": "rds.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadAwsManagedSecretsKey",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:ap-southeast-2:736486260824:key/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        },
        "ForAnyValue:StringEquals": {
          "kms:ResourceAliases": "alias/aws/secretsmanager"
        }
      }
    },
    {
      "Sid": "ConfigureExactNewIdentityPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateResourceServer",
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:CreateUserPoolDomain",
        "cognito-idp:CreateManagedLoginBranding"
      ],
      "Resource": "arn:aws:cognito-idp:ap-southeast-2:736486260824:userpool/RENDER_FRESH_POOL_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "CreateExactLabFrontendBranch",
      "Effect": "Allow",
      "Action": [
        "amplify:CreateBranch",
        "amplify:TagResource"
      ],
      "Resource": "arn:aws:amplify:ap-southeast-2:736486260824:apps/RENDER_FRESH_APP_ID/branches/lab",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "CreateImmutableNamedRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:TagResource"
      ],
      "Resource": "arn:aws:ecr:ap-southeast-2:736486260824:repository/scoutgrid-lab-backend",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    }
  ]
}
