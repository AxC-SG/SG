{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOnlyThreeEncryptedLabSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:scoutgrid-lab/runtime-db-??????",
        "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:scoutgrid-lab/application-settings-??????",
        "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:scoutgrid-lab/managed-installation-??????"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "ScoutGridReleaseOperator",
          "secretsmanager:KmsKeyArn": "arn:aws:kms:ap-southeast-2:736486260824:key/084de131-918e-43dd-a56f-aa8f6d6f0174"
        }
      }
    },
    {
      "Sid": "TagOnlyThreeLabSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:TagResource"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:scoutgrid-lab/runtime-db-??????",
        "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:scoutgrid-lab/application-settings-??????",
        "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:scoutgrid-lab/managed-installation-??????"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "ScoutGridReleaseOperator"
        }
      }
    },
    {
      "Sid": "WriteAndInspectOnlyLabSecretVersions",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:PutSecretValue",
        "secretsmanager:UpdateSecretVersionStage",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecretVersionIds"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:scoutgrid-lab/runtime-db-??????",
        "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:scoutgrid-lab/application-settings-??????",
        "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:scoutgrid-lab/managed-installation-??????"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "ScoutGrid",
          "aws:ResourceTag/Environment": "lab",
          "aws:ResourceTag/Profile": "Standard",
          "aws:ResourceTag/ManagedBy": "ScoutGridReleaseOperator"
        }
      }
    },
    {
      "Sid": "UseKeyOnlyForNewSecretsThroughSecretsManager",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:ap-southeast-2:736486260824:key/084de131-918e-43dd-a56f-aa8f6d6f0174",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "kms:ViaService": "secretsmanager.ap-southeast-2.amazonaws.com",
          "kms:CallerAccount": "736486260824"
        },
        "StringLike": {
          "kms:EncryptionContext:SecretARN": [
            "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:scoutgrid-lab/runtime-db-??????",
            "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:scoutgrid-lab/application-settings-??????",
            "arn:aws:secretsmanager:ap-southeast-2:736486260824:secret:scoutgrid-lab/managed-installation-??????"
          ]
        }
      }
    },
    {
      "Sid": "NeverRetrieveSecretValues",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue"
      ],
      "Resource": "*"
    }
  ]
}
