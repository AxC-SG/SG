{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TagOnlyNewReviewedLabAmplifyApp",
      "Effect": "Allow",
      "Action": [
        "amplify:TagResource"
      ],
      "Resource": "arn:aws:amplify:ap-southeast-2:736486260824:apps/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Application",
            "Environment",
            "Profile",
            "ManagedBy"
          ]
        },
        "Null": {
          "aws:TagKeys": "false"
        }
      }
    },
    {
      "Sid": "TagOnlyNewReviewedLabCognitoPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:TagResource"
      ],
      "Resource": "arn:aws:cognito-idp:ap-southeast-2:736486260824:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Application",
            "Environment",
            "Profile",
            "ManagedBy"
          ]
        },
        "Null": {
          "aws:TagKeys": "false"
        }
      }
    }
  ]
}
