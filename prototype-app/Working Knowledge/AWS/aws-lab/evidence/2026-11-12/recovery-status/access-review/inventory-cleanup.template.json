{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StopOnlyCapturedLabServices",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DeleteService"
      ],
      "Resource": [
        "arn:aws:ecs:ap-southeast-2:736486260824:service/scoutgrid-lab/api",
        "arn:aws:ecs:ap-southeast-2:736486260824:service/scoutgrid-lab/worker"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "StopOnlyCapturedLabTasks",
      "Effect": "Allow",
      "Action": [
        "ecs:StopTask"
      ],
      "Resource": "arn:aws:ecs:ap-southeast-2:736486260824:task/scoutgrid-lab/RENDER_CAPTURED_TASK_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeregisterOnlyCapturedTaskRevisions",
      "Effect": "Allow",
      "Action": [
        "ecs:DeregisterTaskDefinition"
      ],
      "Resource": "arn:aws:ecs:ap-southeast-2:736486260824:task-definition/RENDER_CAPTURED_TASK_REVISION",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteOnlyLabCluster",
      "Effect": "Allow",
      "Action": [
        "ecs:DeleteCluster"
      ],
      "Resource": "arn:aws:ecs:ap-southeast-2:736486260824:cluster/scoutgrid-lab",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteCapturedRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": [
        "arn:aws:iam::736486260824:role/scoutgrid-lab-api-execution",
        "arn:aws:iam::736486260824:role/scoutgrid-lab-worker-execution",
        "arn:aws:iam::736486260824:role/scoutgrid-lab-migrator-execution",
        "arn:aws:iam::736486260824:role/scoutgrid-lab-api-task",
        "arn:aws:iam::736486260824:role/scoutgrid-lab-worker-task"
      ]
    },
    {
      "Sid": "DeleteCapturedLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:DeleteLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-2:736486260824:log-group:/ecs/scoutgrid-lab/api:*",
        "arn:aws:logs:ap-southeast-2:736486260824:log-group:/ecs/scoutgrid-lab/worker:*",
        "arn:aws:logs:ap-southeast-2:736486260824:log-group:/ecs/scoutgrid-lab/migrator:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DisableAndDeleteCapturedDatabase",
      "Effect": "Allow",
      "Action": [
        "rds:ModifyDBInstance",
        "rds:DeleteDBInstance"
      ],
      "Resource": "arn:aws:rds:ap-southeast-2:736486260824:db:scoutgrid-lab",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteCapturedDbGroups",
      "Effect": "Allow",
      "Action": [
        "rds:DeleteDBParameterGroup",
        "rds:DeleteDBSubnetGroup"
      ],
      "Resource": [
        "arn:aws:rds:ap-southeast-2:736486260824:pg:scoutgrid-lab-postgres16",
        "arn:aws:rds:ap-southeast-2:736486260824:subgrp:scoutgrid-lab"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteOnlyCapturedDisposableBackup",
      "Effect": "Allow",
      "Action": [
        "rds:DeleteDBSnapshot"
      ],
      "Resource": "arn:aws:rds:ap-southeast-2:736486260824:snapshot:RENDER_CAPTURED_APPROVED_SNAPSHOT",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteCapturedFrontend",
      "Effect": "Allow",
      "Action": [
        "amplify:DeleteDomainAssociation",
        "amplify:DeleteBranch",
        "amplify:DeleteApp"
      ],
      "Resource": [
        "arn:aws:amplify:ap-southeast-2:736486260824:apps/RENDER_FRESH_APP_ID",
        "arn:aws:amplify:ap-southeast-2:736486260824:apps/RENDER_FRESH_APP_ID/branches/lab",
        "arn:aws:amplify:ap-southeast-2:736486260824:apps/RENDER_FRESH_APP_ID/domains/lab.scoutgrid.io"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DisableAndDeleteCapturedPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:UpdateUserPool",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:DeleteResourceServer",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:DeleteUserPoolDomain",
        "cognito-idp:DeleteManagedLoginBranding"
      ],
      "Resource": "arn:aws:cognito-idp:ap-southeast-2:736486260824:userpool/RENDER_FRESH_POOL_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "EmptyOnlyCapturedLabObjectVersions",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::scoutgrid-lab-736486260824-imports/RENDER_CAPTURED_APPROVED_OBJECT_KEY",
        "arn:aws:s3:::scoutgrid-lab-736486260824-exports/RENDER_CAPTURED_APPROVED_OBJECT_KEY"
      ]
    },
    {
      "Sid": "ListAndDeleteOnlyLabArtifactBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:ListBucketMultipartUploads",
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketCORS"
      ],
      "Resource": [
        "arn:aws:s3:::scoutgrid-lab-736486260824-imports",
        "arn:aws:s3:::scoutgrid-lab-736486260824-exports"
      ]
    },
    {
      "Sid": "DeleteCapturedRegionalWebAcl",
      "Effect": "Allow",
      "Action": [
        "wafv2:DisassociateWebACL",
        "wafv2:DeleteWebACL"
      ],
      "Resource": "arn:aws:wafv2:ap-southeast-2:736486260824:regional/webacl/scoutgrid-lab-api/RENDER_CAPTURED_WEBACL_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "RemoveCapturedAlbWafAssociation",
      "Effect": "Allow",
      "Action": [
        "wafv2:DisassociateWebACL"
      ],
      "Resource": "arn:aws:elasticloadbalancing:ap-southeast-2:736486260824:loadbalancer/app/scoutgrid-lab-api/RENDER_CAPTURED_ALB_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteCapturedAlbTree",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DeleteLoadBalancer",
        "elasticloadbalancing:DeleteTargetGroup",
        "elasticloadbalancing:DeleteListener",
        "elasticloadbalancing:DeleteRule"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:ap-southeast-2:736486260824:loadbalancer/app/scoutgrid-lab-api/RENDER_CAPTURED_ALB_ID",
        "arn:aws:elasticloadbalancing:ap-southeast-2:736486260824:targetgroup/scoutgrid-lab-api/RENDER_CAPTURED_TARGET_ID",
        "arn:aws:elasticloadbalancing:ap-southeast-2:736486260824:listener/app/scoutgrid-lab-api/RENDER_CAPTURED_LISTENER_PATH",
        "arn:aws:elasticloadbalancing:ap-southeast-2:736486260824:listener-rule/app/scoutgrid-lab-api/RENDER_CAPTURED_RULE_PATH"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteCapturedVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVpc",
        "ec2:DetachInternetGateway"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:736486260824:vpc/RENDER_CAPTURED_VPC_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteCapturedSubnet",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSubnet",
        "ec2:DisassociateRouteTable"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:736486260824:subnet/RENDER_CAPTURED_SUBNET_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteCapturedRoutetable",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteRouteTable",
        "ec2:DeleteRoute",
        "ec2:DisassociateRouteTable"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:736486260824:route-table/RENDER_CAPTURED_ROUTE_TABLE_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteCapturedInternetgateway",
      "Effect": "Allow",
      "Action": [
        "ec2:DetachInternetGateway",
        "ec2:DeleteInternetGateway"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:736486260824:internet-gateway/RENDER_CAPTURED_INTERNET_GATEWAY_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteCapturedElasticip",
      "Effect": "Allow",
      "Action": [
        "ec2:ReleaseAddress"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:736486260824:elastic-ip/RENDER_CAPTURED_ELASTIC_IP_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteCapturedNatgateway",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteNatGateway"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:736486260824:natgateway/RENDER_CAPTURED_NATGATEWAY_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteCapturedVpcendpoint",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVpcEndpoints"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:736486260824:vpc-endpoint/RENDER_CAPTURED_VPC_ENDPOINT_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteCapturedSecuritygroup",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSecurityGroup",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:736486260824:security-group/RENDER_CAPTURED_SECURITY_GROUP_ID",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    }
  ]
}
