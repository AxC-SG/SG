{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTaggedFreshSymmetricKeys",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": [
            "Terraform",
            "ScoutGridReleaseOperator"
          ],
          "kms:KeySpec": "SYMMETRIC_DEFAULT",
          "kms:KeyUsage": "ENCRYPT_DECRYPT",
          "kms:KeyOrigin": "AWS_KMS"
        },
        "BoolIfExists": {
          "kms:MultiRegion": "false",
          "kms:BypassPolicyLockoutSafetyCheck": "false"
        }
      }
    },
    {
      "Sid": "EnableRotationOnFreshLabKeys",
      "Effect": "Allow",
      "Action": [
        "kms:EnableKeyRotation"
      ],
      "Resource": "arn:aws:kms:ap-southeast-2:736486260824:key/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Application": "ScoutGrid",
          "aws:ResourceTag/Environment": "lab",
          "aws:ResourceTag/Profile": "Standard",
          "aws:ResourceTag/ManagedBy": [
            "Terraform",
            "ScoutGridReleaseOperator"
          ]
        }
      }
    },
    {
      "Sid": "TagFreshLabKeys",
      "Effect": "Allow",
      "Action": [
        "kms:TagResource"
      ],
      "Resource": "arn:aws:kms:ap-southeast-2:736486260824:key/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": [
            "Terraform",
            "ScoutGridReleaseOperator"
          ],
          "aws:ResourceTag/Application": "ScoutGrid",
          "aws:ResourceTag/Environment": "lab",
          "aws:ResourceTag/Profile": "Standard",
          "aws:ResourceTag/ManagedBy": [
            "Terraform",
            "ScoutGridReleaseOperator"
          ]
        }
      }
    },
    {
      "Sid": "CreateOnlyNamedSydneyLabBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:s3:::scoutgrid-lab-736486260824-imports",
        "arn:aws:s3:::scoutgrid-lab-736486260824-exports"
      ],
      "Condition": {
        "StringEquals": {
          "s3:LocationConstraint": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ConfigureOnlyLabArtifactBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketPolicy",
        "s3:PutBucketCORS",
        "s3:PutBucketTagging"
      ],
      "Resource": [
        "arn:aws:s3:::scoutgrid-lab-736486260824-imports",
        "arn:aws:s3:::scoutgrid-lab-736486260824-exports"
      ]
    },
    {
      "Sid": "CreateTaggedLabIdentityPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateUserPool"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "CreateTaggedLabFrontend",
      "Effect": "Allow",
      "Action": [
        "amplify:CreateApp"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Application": "ScoutGrid",
          "aws:RequestTag/Environment": "lab",
          "aws:RequestTag/Profile": "Standard",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "CreateOnlyEcsServiceLinkedRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "arn:aws:iam::736486260824:role/aws-service-role/ecs.amazonaws.com/AWSServiceRoleForECS",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "ecs.amazonaws.com"
        }
      }
    }
  ]
}
