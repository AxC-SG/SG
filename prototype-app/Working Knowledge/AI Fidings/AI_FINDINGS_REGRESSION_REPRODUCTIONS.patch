+    @Test
+    void reviewReincludeOlderScopeAfterUnrelatedRunShouldReopenFinding() {
+        Tenant tenant = provision("Review multiple runs", "review-runs");
+        UUID connectorId = connector(tenant);
+        UUID firstRun = syncRunFacade.start(tenant).getId();
+        UUID agent = ingestWildcardAgents(tenant, connectorId, firstRun, "review-agent");
+        apiService.addPolicyException(tenant, WILDCARD_POLICY, agent, "EXCLUDED", "review", "tester");
+        assertEquals("AUTO_CLOSED", findingStatus(tenant, WILDCARD_POLICY, agent));
+        UUID secondRun = syncRunFacade.start(tenant).getId();
+        observationService.ingest(tenant, evidenceEnvelope(tenant, connectorId, secondRun,
+                "us-west-2", "BEDROCK_GUARDRAILS", "review-unrelated", List.of(new ArtifactObservation(
+                    "arn:aws:bedrock:us-west-2:123456789012:guardrail/review",
+                    "OTHER_AI_ARTIFACT", "AWS_BEDROCK_GUARDRAIL", "review-guardrail", Map.of()))));
+        apiService.removePolicyException(tenant, WILDCARD_POLICY, agent, "tester");
+        assertEquals("OPEN", findingStatus(tenant, WILDCARD_POLICY, agent),
+                "Reincluding an artifact should reassess its current scope even when a newer unrelated run exists");
+    }
+
+    @Test
+    void reviewEnablingPolicyWithStoredFailureShouldCreateFinding() {
+        Tenant tenant = provision("Review enable", "review-enable");
+        UUID connectorId = connector(tenant);
+        reviewGridApi.updateSelection(tenant, WILDCARD_POLICY, "PREVIEW", "tester", "review");
+        UUID run = syncRunFacade.start(tenant).getId();
+        UUID agent = ingestWildcardAgents(tenant, connectorId, run, "review-preview-agent");
+        assertEquals("FAIL", evaluationOutcome(tenant, run, WILDCARD_POLICY, agent));
+        assertEquals(0, apiService.findings(tenant, WILDCARD_POLICY, "OPEN", 0, 100).items().size());
+        reviewGridApi.updateSelection(tenant, WILDCARD_POLICY, "ENABLED", "tester", "review");
+        assertEquals(1, apiService.findings(tenant, WILDCARD_POLICY, "OPEN", 0, 100).items().size(),
+                "Enabling a policy with a known current failure should graduate it into a finding");
+    }
