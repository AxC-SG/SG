# CI-only image build for supply-chain and container-security scanning.
# Production frontend deployments use Vercel (vercel.json), not this image.
FROM node:26-alpine@sha256:40cd011b55415bc894e45b02fdd5a5dfde056921b7d23a64c74f80497af48797 AS build
WORKDIR /workspace
ARG VITE_TURNSTILE_SITE_KEY
ENV VITE_TURNSTILE_SITE_KEY=${VITE_TURNSTILE_SITE_KEY}
COPY package.json package-lock.json ./
# Serialize lifecycle scripts so esbuild validation cannot race npm binary writes.
RUN apk add --no-cache 'libssl3>=3.3.7-r0' && npm ci --foreground-scripts
COPY . .
RUN npm run build

FROM nginx:1.31-alpine@sha256:785835ea65db4bba6f021acc0f3be91b0fef76a53fe41f8588c6698d2aed0606
# Require the patched decoder for CVE-2026-111497 in the pinned runtime image.
RUN apk add --no-cache 'libssl3>=3.3.7-r0' 'brotli-libs>=1.2.1-r0'
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/dist /usr/share/nginx/html
EXPOSE 8080
