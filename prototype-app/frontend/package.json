{
  "name": "vulnwatch-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b --force && vite build && node scripts/verify-production-bundle.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:build": "node e2e/build-artifacts.mjs",
    "e2e:journeys": "node e2e/run.mjs journeys",
    "e2e:sweep": "node e2e/run.mjs sweep",
    "e2e:visual": "node e2e/run.mjs visual",
    "e2e:update": "node e2e/run.mjs update",
    "e2e:affected": "node e2e/run.mjs affected",
    "e2e:live": "node e2e/live-journeys.mjs",
    "e2e:verify-archive": "node e2e/verify-archive.mjs",
    "test:e2e-runner": "node --test e2e/runner.test.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@sentry/react": "^11.11.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.12.0",
    "docx": "^9.15.3",
    "lucide-react": "^1.66.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
