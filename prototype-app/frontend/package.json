{
  "name": "vulnwatch-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b --force && vite build && node scripts/verify-production-bundle.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:build": "node e2e/build-artifacts.mjs",
    "e2e:journeys": "node e2e/run.mjs journeys",
    "e2e:sweep": "node e2e/run.mjs sweep",
    "e2e:visual": "node e2e/run.mjs visual",
    "e2e:update": "node e2e/run.mjs update",
    "e2e:affected": "node e2e/run.mjs affected",
    "e2e:live": "node e2e/live-journeys.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/react": "^10.51.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.2",
    "docx": "^9.6.1",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "vike": "^0.4.264",
    "vike-react": "^0.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "axe-core": "4.10.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "14.0.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
