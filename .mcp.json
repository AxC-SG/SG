{
  "mcpServers": {
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "azure-mcp": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@4.0.0-beta.7",
        "server",
        "start",
        "--mode",
        "consolidated"
      ],
      "enabled": true,
      "tools": ["*"]
    }
  }
}
