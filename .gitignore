.DS_Store
.sentry-local/

# Local runtime data and secrets
prototype-app/backend/data/
prototype-app/backend/secrets/
prototype-app/backend/.env
prototype-app/backend/.env.*
!prototype-app/backend/.env.example
prototype-app/backend/src/main/resources/application-local.yml
prototype-app/frontend/.env
prototype-app/frontend/.env.*

# Build artifacts
/output/
prototype-app/backend/target/
prototype-app/frontend/dist/
prototype-app/frontend/coverage/

# Dependency caches
node_modules/
prototype-app/frontend/node_modules/
.vercel

# Secrets and credentials — never commit
**/secrets/
.env
.env.*
!.env.example
**/application-local.yml
**/application-local.yaml
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Build output, editor and log files
dist/
target/
coverage/
.idea/
.vscode/
*.log

# UI 2.0 checkpoint screenshots stay on disk, out of git
prototype-app/Working Knowledge/New UI 2.0/checkpoints/**/*.png
